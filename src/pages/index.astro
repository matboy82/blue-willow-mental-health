---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import { practice } from '../lib/practice';
const steps = [
  { title: 'Book online', text: 'Request a time through our secure portal. The practice confirms your appointment and provides your next steps.' },
  { title: 'Complete your screening', text: 'Computer-based screening adds objective information to the picture. The practice will guide you through what to complete.' },
  { title: 'Talk it through', text: 'Meet by secure video for a 60–90 minute review. Discuss your history, your results, and a plan for what comes next.' },
];
---
<Layout title="ADHD assessments for teens & adults in Kentucky" description="Focused ADHD assessments by telehealth across Kentucky. Based in Louisville. $225 initial assessment, $100 follow-up. Request an appointment online." faq>
  <section class="hero"><div class="wrap hero-grid">
    <div><span class="eyebrow">Louisville roots. Kentucky reach.</span><h1>Is it ADHD?<br />Get a clear answer.</h1>
      <p class="lead">Focused ADHD assessments for teens and adults — from home, by telehealth. Objective screening, a specialist’s perspective, and honest flat pricing.</p>
      <div class="hero-ctas"><a class="btn" href={practice.booking} rel="noreferrer">Book your assessment</a><a class="btn btn-ghost" href="#how">How it works</a></div>
      <p class="micro-trust"><strong>$225 flat intake</strong> · Licensed psychiatric provider<br />Telehealth across Kentucky · Cash pay</p>
    </div>
    <figure class="hero-art"><img src="/willow-mark.jpg" alt="A blue willow tree with long, flowing branches" width="440" height="508" fetchpriority="high" /><figcaption>Rooted in care. Focused on clarity.<small>A little less uncertainty. A way forward.</small></figcaption></figure>
  </div></section>
  <div class="trust"><div class="wrap trust-grid">
    {[['Focused care', 'A practice built around ADHD.'], ['Transparent pricing', '$225 intake · $100 follow-up.'], ['Telehealth statewide', 'From home, anywhere in Kentucky.'], ['Objective screening', 'Data to support a clinical review.']].map(([title, text]) => <div class="trust-item"><span class="tick" aria-hidden="true">✓</span><div><strong>{title}</strong><span>{text}</span></div></div>)}
  </div></div>
  <section class="block" id="how"><div class="wrap"><div class="kicker">How it works</div><h2 class="section-title">Three steps toward clarity.</h2><p class="section-sub">A focused process. Time to ask questions. A plan you can understand.</p><div class="steps">{steps.map((s, i) => <article class="step"><div class="num" aria-hidden="true">0{i + 1}</div><h3>{s.title}</h3><p>{s.text}</p></article>)}</div><a class="text-link" href="/how-it-works/">A closer look at the process →</a></div></section>
  <section class="block who-section" id="who"><div class="wrap"><div class="kicker">Who it’s for</div><h2 class="section-title">Different stories. The same need for answers.</h2><p class="section-sub">You don’t need to have it figured out before you reach out.</p><div class="who-grid">
    <article class="who-card parents"><span class="card-label">Teens & their families</span><h3>“Is it ADHD or something else?”</h3><p>When school, routines, or everyday tasks feel harder than they should, a focused assessment can help you understand the next step.</p><ul><li>Time to share your concerns</li><li>Screening alongside clinical history</li><li>Next steps to discuss together</li></ul><a class="text-link" href="/adhd-assessment-for-teens/">Explore assessments for teens →</a></article>
    <article class="who-card adults"><span class="card-label">Adults</span><h3>“I’ve wondered about this for years.”</h3><p>You’ve found ways to get through the day, but focus and follow-through still take a lot out of you. Bring your questions to a specialist.</p><ul><li>A consult focused on your experience</li><li>A thoughtful look at your history</li><li>A conversation about your options</li></ul><a class="text-link" href="/adhd-assessment-for-adults/">Explore assessments for adults →</a></article>
  </div></div></section>
  <section class="block pricing" id="pricing"><div class="wrap"><div class="kicker">Pricing</div><h2 class="section-title">Honest prices, published upfront.</h2><p class="section-sub">Cash pay. Clear fees. Know the price before your visit.</p><Pricing /></div></section>
  <section class="block" id="faq"><div class="wrap faq-grid"><div><div class="kicker">Fair questions</div><h2 class="section-title">Let’s make it clearer.</h2><p class="section-sub">A few things you might be wondering before you book.</p><a class="text-link" href="/contact/">Have another question? →</a></div><Faq /></div></section>
  <section class="block about-section"><div class="wrap"><div class="about"><div class="about-art" aria-hidden="true"><img src="/willow-mark.jpg" alt="" width="440" height="508" loading="lazy" /></div><div><div class="kicker">About the practice</div><h2>Focused care.<br />A thoughtful way forward.</h2><p>Blue Willow Mental Health is a telehealth practice led by a licensed psychiatric provider with a focus on ADHD.</p><p>Rooted in the St. Matthews area of Louisville, we work with adolescents and adults across Kentucky. Our approach brings screening and clinical conversation together.</p><a class="text-link" href="/about/">Get to know the practice →</a></div></div></div></section>
  <Booking />
</Layout>
