---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const answers = (await getCollection('answers')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="ADHD assessment answers" description="Answers to questions about ADHD assessments at Blue Willow Mental Health: the process, preparation, cost, and telehealth across Kentucky.">
  <section class="page-hero"><div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Answers</span></nav>
    <div class="kicker">Answers</div><h1>ADHD assessment questions, answered.</h1>
  </div></section>
  <section class="block"><div class="wrap"><ul class="answer-list">
    {answers.map(answer => <li><article><h2><a href={`/answers/${answer.id}/`}>{answer.data.question}</a></h2><p>{answer.data.summary}</p></article></li>)}
  </ul></div></section>
</Layout>
<style>
  .answer-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .answer-list article { height: 100%; padding: 2rem; border: 1px solid var(--powder); border-radius: var(--radius); background: var(--white); }
  .answer-list h2 { font-size: 1.5rem; margin-bottom: 1rem; }
  .answer-list p { color: var(--muted); }
  @media (max-width: 700px) { .answer-list { grid-template-columns: 1fr; } .answer-list article { padding: 1.5rem; } }
</style>
