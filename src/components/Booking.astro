---
import { practice } from '../lib/practice';
---
<section class="block" id="book" aria-labelledby="booking-heading">
  <div class="wrap"><div class="final">
    <div class="kicker light">Your next step</div>
    <h2 id="booking-heading">Clarity starts with a conversation.</h2>
    <p>Request your $225 assessment through our secure SimplePractice portal. Choose a time and let the practice confirm your appointment.</p>
    <a class="btn" href={practice.booking} rel="noreferrer">Book your $225 assessment ↗</a>
    <p class="booking-note">Scheduling, payment, and clinical paperwork stay in SimplePractice.</p>
  </div></div>
</section>
